# ============================================================
# BR Dental Clinic - environment configuration
#
# Copy this file to config/secrets.local.php and fill in your own values.
# NEVER commit config/secrets.local.php - it is already in .gitignore.
#
# The application also accepts real environment variables with the same
# names, which is how you would configure it on a hosting panel.
# ============================================================

# ---- Database -------------------------------------------------------------
# Leave these out on XAMPP: it defaults to root with no password.
# 'DB_HOST' => 'localhost',
# 'DB_NAME' => 'clinic',
# 'DB_USER' => 'your_db_user',
# 'DB_PASSWORD' => 'your_db_password',

# ---- Application environment ---------------------------------------------
# 'development' shows helpful details; 'production' hides them.
# Set this to 'production' on the live site.
# 'APP_ENV' => 'production',

# ---- Outgoing mail (password reset links) --------------------------------
# Without these, the app still works: reset links are written to the PHP
# error log and shown on screen instead of being emailed. That is fine for
# local XAMPP development and must be replaced before going live.
#
# SMTP_HOST       your provider's SMTP server
# SMTP_PORT       465 = implicit TLS (recommended), 587 = STARTTLS
# SMTP_USER       the full mailbox address or login name
# SMTP_PASS       the password, or an app password if 2FA is on
# SMTP_FROM       the From address shown to the patient
# SMTP_FROM_NAME  the display name shown to the patient
# SMTP_SECURE     tls | starttls | none  (defaults from the port)
#
# Gmail requires an App Password (Google Account > Security > 2-Step
# Verification > App passwords). Your normal password will be rejected.

# 'SMTP_HOST'      => 'smtp.gmail.com',
# 'SMTP_PORT'      => '465',
# 'SMTP_USER'      => 'your.address@gmail.com',
# 'SMTP_PASS'      => 'your-app-password',
# 'SMTP_FROM'      => 'your.address@gmail.com',
# 'SMTP_FROM_NAME' => 'BR Dental Clinic',
# 'SMTP_SECURE'    => 'tls',
