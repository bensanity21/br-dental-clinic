# Reference for hosting-panel environment variables. This file is not loaded by
# PHP and must never contain real credentials. Copy the values into your host's
# secret/environment-variable manager; do not commit populated values.

APP_ENV=production
APP_BASE_URL=https://your-clinic-domain.example

DB_HOST=127.0.0.1
DB_NAME=clinic
DB_USER=br_dental_app
DB_PASSWORD=REPLACE_WITH_A_GENERATED_SECRET

# Generate with: php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
BR_DENTAL_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS
# Set only temporarily during a planned key rotation.
BR_DENTAL_ENCRYPTION_KEY_PREVIOUS=

SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=tls
SMTP_USER=clinic-mailbox@example.com
SMTP_PASS=REPLACE_WITH_MAIL_SECRET
SMTP_FROM=clinic-mailbox@example.com
SMTP_FROM_NAME=BR Dental Clinic

# Set to 1 only when a trusted reverse proxy overwrites X-Forwarded-Proto.
# TRUST_PROXY_HEADERS=1

# Never set ALLOW_RESET_LINK_IN_RESPONSE on a public/production host.
